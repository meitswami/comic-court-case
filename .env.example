# =============================================================================
# eNyayaSetu - Environment Variables
# Copy this file to .env and fill in your own values.
# DO NOT commit your real .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MySQL)
# Tested on Hostinger Cloud MySQL, but any MySQL 5.7+ works.
# -----------------------------------------------------------------------------
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=enyayasetu

# -----------------------------------------------------------------------------
# Authentication
# Generate a strong random secret, e.g. via `openssl rand -base64 32`
# or https://randomkeygen.com/
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-32-plus-character-random-string
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Server / API
# -----------------------------------------------------------------------------
API_PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# Frontend (Vite) - exposed to the browser, do NOT put secrets here.
# Leave VITE_API_URL blank when frontend & backend share an origin
# (production: nginx proxies /api to the Express server).
# -----------------------------------------------------------------------------
VITE_API_URL=

# -----------------------------------------------------------------------------
# Optional server settings
# -----------------------------------------------------------------------------
# Public address of the site. Used for payment return and webhook URLs.
# Normally worked out from the request; set it if the site sits behind an
# unusual proxy.
# PUBLIC_URL=https://enyayasetu.example.com

# Where uploaded files are kept (default: ./storage). Back this folder up.
# STORAGE_DIR=/var/lib/enyayasetu/storage
# STORAGE_USER_QUOTA_MB=2048

# AI / voice requests one account may make per minute (default 40)
# AI_RATE_LIMIT_PER_MINUTE=40

# -----------------------------------------------------------------------------
# Integrations
# Set these from the admin console instead (Admin > Settings, Admin >
# Gateways). The variables below are only a fallback for AI, voice and email;
# payment gateway keys are never read from this file.
# -----------------------------------------------------------------------------
# AI_API_KEY=            # Gemini (AIza...) or OpenAI (sk-...)
# AI_MODEL=
# ELEVENLABS_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=eNyayaSetu <no-reply@yourdomain.com>
