# =============================================================================
# eNyayaSetu - Environment Variables
# Copy this file to .env and fill in your own values.
# DO NOT commit your real .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MySQL)
# Tested on Hostinger Cloud MySQL, but any MySQL 5.7+ works.
# -----------------------------------------------------------------------------
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=enyayasetu

# -----------------------------------------------------------------------------
# Authentication
# Generate a strong random secret, e.g. via `openssl rand -base64 32`
# or https://randomkeygen.com/
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-32-plus-character-random-string
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Server / API
# -----------------------------------------------------------------------------
API_PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# Frontend (Vite) - exposed to the browser, do NOT put secrets here.
# Leave VITE_API_URL blank when frontend & backend share an origin
# (production: nginx proxies /api to the Express server).
# -----------------------------------------------------------------------------
VITE_API_URL=

# -----------------------------------------------------------------------------
# Case preparation workspace (/workspaces)
# -----------------------------------------------------------------------------
# AES-256-GCM key for uploaded case documents. REQUIRED when NODE_ENV=production
# (uploads are refused without it). 32 bytes as base64 or 64 hex characters:
#   openssl rand -base64 32
# Keep a secure backup: files encrypted with a lost key cannot be recovered.
CASE_PREP_ENCRYPTION_KEY=
# Private folder for uploaded documents (default: <repo>/storage/case-prep).
# Must NOT be inside public/. The API service user needs read/write access.
# CASE_PREP_STORAGE_DIR=/var/lib/enyayasetu/case-prep

# AI provider: any OpenAI-compatible chat-completions endpoint. Documents are
# sent to this provider for analysis. Remote endpoints must use HTTPS.
# Existing gateway (same as the legacy Edge Functions):
#   AI_API_BASE_URL=https://ai.gateway.lovable.dev/v1  AI_MODEL=google/gemini-2.5-flash  AI_VISION=true
# Self-hosted on the VPS (no third party sees the documents):
#   AI_API_BASE_URL=http://127.0.0.1:11434/v1  AI_MODEL=llama3.1:8b  AI_VISION=false
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
# true only if the model accepts images (needed to read photographed pages)
AI_VISION=false
# AI_TIMEOUT_MS=90000

# -----------------------------------------------------------------------------
# Optional integrations (set in the platform secrets store, not here)
# -----------------------------------------------------------------------------
# ELEVENLABS_API_KEY=
# RESEND_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SUPABASE_URL=        # only if you still use Supabase Storage for evidence
# SUPABASE_SERVICE_KEY=
